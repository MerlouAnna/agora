{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Generate mock data",
      "type": "debugpy",
      "request": "launch",
      "module": "tools.generate_mock_data",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "data_service :8001",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["services.data_service.main:app", "--port", "8001"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "offer_service :8000",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["services.offer_service.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
